# Runtime / OS
.DS_Store
*.log
.logs/

# Swift / SwiftPM
.build/
.swiftpm/
# Package.resolved IS tracked, deliberately. It was ignored while this package had
# no external dependencies at all (CLua and HammerdeckNotify are local targets), so
# the lockfile pinned nothing and committing it was noise. Sparkle changed that:
# `from: "2.9.5"` admits any 2.x, and without a committed lockfile CI resolves
# fresh on every run -- so re-running the same tag months later would notarize a
# DIFFERENT updater. This is the component that can replace the app on a user's
# machine; its version belongs in the commit, not in whatever the network returned.

# Python bytecode -- scripts/gen-readme-features.py is run directly and by CI,
# and any import of it (a syntax check, a REPL) leaves a __pycache__ behind.
__pycache__/
*.pyc

# Editor
.vscode/
.idea/
/.deleted

# Generated LuaLS require-name redirect stubs (scripts/check-lua-types.sh)
.luals-stubs/

# Local dev secrets (e.g. OPENAI_KEY for text_actions) -- never commit
.env

# Dev artwork scratch (mockups, screenshots) stays out of git -- EXCEPT the
# runtime app icon, which the packaged .app bundles, so it must be tracked for a
# clean checkout / CI build to be reproducible (resourceRoot()/design/AppIcon.png).
/design/*
!/design/AppIcon.png

# Packaged build output
/dist/
/image

# firebase CLI deploy cache, written by scripts/publish-site.sh. Local build
# state, not repo content.
/.firebase/

# Private working notes -- scratch thinking that lives next to the code but NEVER
# ships. (Business / strategy / pricing docs do not belong in this repo at all --
# see "Where a document goes" in CLAUDE.md.)
/notes/

# Personal backlog -- never committed (it names unreleased plans + private paths).
/TODO.md

# docs-private/ -- an ALIAS (symlink) to the private doc set, which is STORED in the
# author's separate private repo, never here. Two folders, one rule you can see at a
# glance: docs/ is public, docs-private/ is not.
#
# It must stay ignored: git stores a symlink as its TARGET PATH, so committing this
# would publish the private repo's location. A doc goes public by being MOVED from
# docs-private/ into docs/ -- reviewed against the code first, since docs/ has no
# history to hide in and anything committed there is public for good.
/docs-private

# .meta -- durable app facts (feedback routing, portfolio entry) read by the
# portfolio tooling. Same arrangement, same reason as docs-private above: it is a
# SYMLINK into the author's private data repo, so committing it would publish that
# repo's location.
#
# NO TRAILING SLASH, and that is not a style choice: a trailing slash matches only
# directories, and a symlink is not a directory. `/.meta/` would fail to match this
# link, git would happily commit it, and the private path would ship.
/.meta
/scratchpad
