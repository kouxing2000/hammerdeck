#!/usr/bin/env bash
#
# pre-commit: refuse to commit business/strategy content into this PUBLIC repo.
#
# Why this exists: commercial content (what to charge, who we're up against, how we
# launch) must never enter a public repo's history. Deleting it later does NOT undo
# it -- a RENAMED file leaves its content at the old path, and a DELETED one survives
# in history where no check of the working tree can see it. Only a full history
# rewrite removes it, so the only reliable fix is to block the commit.
#
# Where such content belongs:
#   - the author's separate private repo
#   - local scratch:  notes/   (gitignored)
# See "Where a document goes" in CLAUDE.md.
#
# The commit MESSAGE publishes with the code too: scripts/hooks/commit-msg runs
# this same scan over it (--msg).
#
# Install:  git config core.hooksPath scripts/hooks
# Bypass (ONLY for a genuine false positive):  git commit --no-verify
#
# CI backstop: `scripts/hooks/pre-commit --all` scans EVERY tracked file instead
# of the staged set -- ci.yml runs it so content that rode in on a --no-verify
# or hookless commit still turns the build red before the repo is public.

set -uo pipefail

MODE=staged
if [ "${1:-}" = "--all" ]; then
    MODE=all
    # git ls-files is cwd-relative: from a subdirectory it silently scans a
    # SUBSET and exits 0 -- indistinguishable from a clean full scan. Pin to the
    # repo root and refuse an empty list, so a partial scan can never pass green.
    cd "$(git rev-parse --show-toplevel)" || exit 1
    list_files() { git ls-files; }
    # Whole-tree sweep: the working file IS the subject, and a tracked path with
    # no working file is a pending deletion with nothing left to scan.
    read_candidate() { [ -f "$1" ] && cat -- "$1" > "$SCAN_TMP"; }
    if [ -z "$(git ls-files | head -1)" ]; then
        printf 'pre-commit --all: git ls-files returned nothing -- refusing a vacuous pass.\n' >&2
        exit 1
    fi
elif [ "${1:-}" = "--msg" ]; then
    # The commit-msg hook: a commit message publishes with the code, so it gets the
    # same scan as a file. Every line is scanned, "#" lines included: with -m / -F
    # git keeps them in the published message. Only what follows the scissors line
    # is dropped -- that is the diff `git commit -v` shows, never part of the message.
    MODE=msg
    MSG_FILE="${2:?--msg needs the commit message file}"
    list_files() { printf '%s\n' "(commit message)"; }
    read_candidate() { sed '/^[^ ] -\{24\} >8 -\{24\}$/,$d' "$MSG_FILE" > "$SCAN_TMP"; }
else
    list_files() { git diff --cached --name-only --diff-filter=ACM; }
    # The INDEX blob, never the working file. A commit writes what is staged, so
    # reading the working copy asks about bytes that are not the ones going into
    # history: stage prohibited content, then clean or delete the working file,
    # and a hook that greps the working tree finds nothing and lets the staged
    # blob through. `git show ":$f"` is the object the commit will actually
    # record, and it exists even when the path no longer does on disk.
    read_candidate() { git show ":$1" > "$SCAN_TMP" 2>/dev/null; }
fi

# Unambiguous business-strategy signals. Deliberately EXCLUDES words that carry a
# common technical meaning here -- e.g. "subscription" (the rules engine is full of
# event subscriptions) -- so the hook stays quiet enough to be trusted.
PATTERN='pricing|freemium|monetiz|willingness[- ]to[- ]pay|paywall|go[- ]to[- ]market|revenue|competitor|Show HN|\bmoat\b'

# Files whose JOB is to state this policy -- they necessarily name the banned words
# and would otherwise trip the hook on every commit. Keep this list tiny: each entry
# is a file the hook can no longer protect, so it must be one you review by eye.
EXEMPT=(
    "scripts/hooks/pre-commit"   # this file: the pattern itself
    ".gitignore"                 # the notes/ comment explaining what must not ship
    "CLAUDE.md"                  # the "Where a document goes" rule
)

# Per-process temp, atomic in the sense that matters here: two hooks running at
# once (a commit while CI runs --all) must not scan each other's bytes.
SCAN_TMP="$(mktemp "${TMPDIR:-/tmp}/pre-commit-scan.$$.XXXXXX")"
NAMES_TMP="$(mktemp "${TMPDIR:-/tmp}/pre-commit-names.$$.XXXXXX")"
trap 'rm -f "$SCAN_TMP" "$NAMES_TMP"' EXIT

# Names that must never reach this public repo: the author's private repos, their
# home path. The list lives OUTSIDE the tracked tree, in .git/info/private-names
# (never committed, never pushed), because committing a list of private names
# would publish them. One fixed string per line, matched case-insensitively; "#"
# lines are comments. No list (CI, a fresh clone) means no private-name check.
# Unlike PATTERN this applies to the EXEMPT files too: none has a reason to hold one.
# --git-path, not --git-dir: a linked worktree's git dir is .git/worktrees/<name>,
# and the list lives in the main repo's .git/info, which every worktree shares.
PRIVATE_LIST="$(git rev-parse --git-path info/private-names 2>/dev/null)"
if [ -f "$PRIVATE_LIST" ]; then
    grep -v -e '^#' -e '^[[:space:]]*$' -- "$PRIVATE_LIST" > "$NAMES_TMP"
fi

is_exempt() {
    local candidate="$1" e
    for e in "${EXEMPT[@]}"; do
        [ "$candidate" = "$e" ] && return 0
    done
    return 1
}

found=0

while IFS= read -r f; do
    # Materialize the candidate bytes ONCE, then classify and scan the same file.
    # Reading into a shell variable instead would silently drop NUL bytes (bash
    # warns and truncates), which both mangles binaries and re-reads a path that
    # may be changing underneath us.
    : > "$SCAN_TMP"
    read_candidate "$f"
    [ -s "$SCAN_TMP" ] || continue
    # Skip binaries (icons, bundles) -- grep on them is noise. Asked of the bytes
    # in hand, so the staged blob is classified rather than whatever the working
    # tree happens to hold at that path.
    if file --mime "$SCAN_TMP" 2>/dev/null | grep -q 'charset=binary'; then
        continue
    fi
    matches=""
    if ! is_exempt "$f"; then
        matches=$(grep -inE "$PATTERN" -- "$SCAN_TMP" 2>/dev/null | head -5)
    fi
    if [ -s "$NAMES_TMP" ]; then
        private=$(grep -inF -f "$NAMES_TMP" -- "$SCAN_TMP" 2>/dev/null | head -5)
        [ -n "$private" ] && matches="${matches:+$matches$'\n'}$private"
    fi
    if [ -n "$matches" ]; then
        if [ "$found" -eq 0 ]; then
            printf '\n\033[31mBLOCKED\033[0m: business/strategy content or a private name in %s.\n' \
                "$([ "$MODE" = msg ] && echo "the commit message" || echo "a checked file")" >&2
            printf 'This repo is PUBLIC -- that content must not enter its history.\n\n' >&2
            found=1
        fi
        printf '  %s\n' "$f" >&2
        printf '%s\n' "$matches" | sed 's/^/      /' >&2
    fi
done < <(list_files)

if [ "$found" -eq 1 ]; then
    if [ "$MODE" = msg ]; then
        printf '\nTake it out of the message and commit again.\n' >&2
    else
        printf '\nMove it to your private strategy repo, or to the gitignored notes/ dir.\n' >&2
    fi
    printf 'See "Where a document goes" in CLAUDE.md.\n' >&2
    printf '\nGenuine false positive? Re-run with:  git commit --no-verify\n\n' >&2
    exit 1
fi

exit 0
